# Copia in .env.local per lo sviluppo. In produzione imposta le stesse variabili su Vercel.
# Nessuna di queste ha il prefisso VITE_: restano sul server e non finiscono nel bundle.

DATABASE_URL=postgres://parkapp:parkapp_dev@localhost:5434/parkapp_dev
# Database usato da `npm test`: viene azzerato ad ogni esecuzione
TEST_DATABASE_URL=postgres://parkapp:parkapp_dev@localhost:5434/parkapp_test

# Base dei link inviati via email
APP_BASE_URL=http://localhost:5173/

# SMTP: in sviluppo punta a Mailpit (docker compose)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Park app <noreply@park-app.com>
MAIL_REPLY_TO=noreply@park-app.com

# Solo produzione: Vercel lo invia come Bearer token alle chiamate del cron
CRON_SECRET=
